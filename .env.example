# 复制为 .env 后填写真实值；切勿把填好的 .env 提交到仓库

# 本机 MySQL root 密码（开发/部署脚本用）
MYSQL_ROOT_PASSWORD=

# 应用库账号与密码
DB_USER=case_app
DB_PASSWORD=

# 目标 Windows 服务器管理员密码（WinRM）
GSMS_PASS=

# 系统 UI 登录密码（UI 验证脚本用）
GSMS_PASSWORD=

# JWT 签名密钥（32 字节以上）
JWT_SECRET=

# 敏感字段加密密钥
CRYPTO_SECRET=

# 附件根目录（服务器无 E 盘时改为 C:/GSMS/data/files）
STORAGE_ROOT=
STORAGE_TEMP=
